<% content_for :title, @gift.name %>
<div class="flex sm:items-baseline justify-between gap-2 sm:flex-row flex-col">
  <div class="flex sm:items-baseline gap-2 text-center sm:flex-row flex-col">
    <h1 class="text-2xl font-semibold tracking-tight"><%= @gift.name %></h1>
    <span class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs text-stone-600">
      <%= @gift.slug %>
    </span>
  </div>
  <%= link_to "&larr; All Gifts".html_safe, gifts_path, class: "text-sm text-stone-500 hover:text-stone-900" %>
</div>

<%= render "gifts/detail", gift: @gift %>

<dl class="mt-4 flex justify-end flex-col sm:flex-row gap-3 text-sm">
  <div class="rounded-lg bg-white px-4 py-3">
    <dt class="text-xs text-stone-500">Registered</dt>
    <dd class="mt-1"><%= @gift.created_at.to_date.to_fs(:long) %></dd>
  </div>
  <div class="rounded-lg bg-white px-4 py-3">
    <dt class="text-xs text-stone-500">Updated</dt>
    <dd class="mt-1"><%= time_ago_in_words(@gift.updated_at) %> ago</dd>
  </div>
</dl>

<section class="mt-4 flex flex-col rounded-lg bg-white px-4 py-3">
  <h4>Contributions</h4>
  <hr class="h-px my-1 bg-stone-200 border-0">
  <%= render "contributions/list", contributions: @gift.contributions %>
</section>