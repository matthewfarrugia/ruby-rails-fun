<article class="rounded-lg bg-white sm:mt-6 mt-2 p-[clamp(1rem,4vw,2.5rem)]">
  <div class="flex flex-col items-stretch sm:flex-row gap-6 sm:gap-8">
    <% if gift.image.present? %>
      <div class="w-full sm:w-2/5 sm:max-w-xs shrink-0 rounded-lg overflow-hidden">
        <%= image_tag gift.image, alt: gift.name, class: "w-full aspect-square object-cover" %>
      </div>
    <% end %>

    <div class="min-w-0 flex-1 flex flex-col justify-center gap-4">
      <% if gift.summary.present? %>
        <p class="text-lg leading-relaxed text-pretty text-stone-500">
          <%= gift.summary %>
        </p>
      <% end %>

      <% if gift.amount > 0 %>
        <p class="font-medium text-peach">
          <%= gift.amount.format  %>
        </p>
      <% end %>

      <%= turbo_frame_tag :contribution_form do %>
        <% if gift.accepts_contributions or gift.contributions.count == 0 %>
          <%= link_to new_gift_contribution_path(gift),
            class: "block w-full rounded-lg p-1 text-center text-white bg-burntpeach" do %>
            <%= gift.accepts_contributions ? "Make Contribution" : "Register Gift" %>
          <% end %>
        <% else %>
          <span class="font-medium text-peach">
            Already gifted
          </span>
        <% end %>
      <% end %>

      <%= render "gifts/contributions_count", gift: gift %>
    </div>
  </div>
</article>
