<div class="flex sm:items-baseline justify-between gap-2 sm:flex-row flex-col">
  <h1 class="text-2xl font-semibold tracking-tight">Contribute to '<%= @gift.name %>'</h1>
  <%= link_to "&larr; All Gifts".html_safe, gifts_path, class: "text-sm text-stone-500 hover:text-stone-900" %>
</div>

<article class="rounded-lg bg-white sm:mt-6 mt-2 p-[clamp(1rem,4vw,2.5rem)]">
  <%= turbo_frame_tag :contribution_form do %>
    <%= render "contributions/form", form: @form, gift: @gift %>
  <% end %>
</article>
