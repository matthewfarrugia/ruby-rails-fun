<article class="bg-white rounded-lg p-[clamp(.6rem,2.5vw,1rem)] group hover:shadow transition-shadow h-full w-full overflow-hidden">
  <div class="flex flex-col items-center justify-between gap-4 h-full w-full">
    <% if gift.image.present? %>
      <div class="rounded-lg overflow-hidden w-full">
        <%= image_tag gift.image, alt: gift.name, class: "aspect-square object-cover" %>
      </div>
    <% end %>

    <div class="flex flex-col items-center justify-between text-center gap-10 w-full grow shrink">
      <h4 class="font-medium text-peach group-hover:underline">
        <%= gift.name %>
      </h4>

      <% if gift.amount > 0 %>
        <p class="font-medium text-peach">
          <%= gift.amount.format  %>
        </p>
      <% end %>

      <% if gift.summary.present? %>
        <p class="mt-1 min-w-0 text-sm text-stone-500">
          <%= gift.summary %>
        </p>
      <% end %>

      <div class="flex flex-col gap-2 w-full">
        <%# Styled as a button but deliberately not one: callers wrap this partial %>
        <%# in a link, and interactive elements may not nest inside an anchor. %>
        <% if gift.accepts_contributions or gift.contributions.count == 0 %>
          <span class="block w-full rounded-lg p-1 text-white bg-burntpeach group-hover:bg-tooburnt transition-colors">
            <%= gift.accepts_contributions ? "Contribute" : "Gift" %>
          </span>
        <% else %>
          <span class="block w-full rounded-lg p-1 bg-stone-100 text-black">
            Already gifted
          </span>
        <% end %>
        <%= render "gifts/contributions_count", gift: gift %>
      </div>
    </div>
  </div>
</article>
